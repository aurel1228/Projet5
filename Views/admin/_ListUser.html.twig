{% for user in Users %}
            <tr>
               <td>{{ user.pseudo }}</td>
               <td>{{ user.role }}</td>
               <td><a href="/Admin/Modifier?id={{ user.id }}">modifier</a></td>
               <td><a href="/Admin/Delete?id={{ user.id }}">supprimer</a></td>     
               <td>{% if user.avatar is not null %}<img src="/images/avatar/{{ user.avatar }}" alt="image de l'avatar" style="width: 50px; height: 50px;">{% endif %}</td> 
            </tr> 
{% endfor %}             


