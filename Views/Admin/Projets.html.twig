{% set titre = "page de mes projets" %}
{% include "/Admin/_headAdmin.html.twig"  %}
   <body>
      {% include "/_logoutButton.html.twig" %}
      {% include "/_info.html.twig" %}
    <table id="tableauProjets">
         <thead>
            <tr>
               <th scope="col">Lien vers le projet</th>
               <th scope="col">Numéro du projet</th>
               <th scope="col">Modifier</th>
               <th scope="col">Supprimer</th>
               <th scope="col">Icon</th>
            </tr>
         </thead>
         <tbody>
            {% for projet in Projets %}
                <tr>
                <td>{{ projet.lien }}</td>
                <td>{{ projet.ordre}}</td>
                <td><a href="/Admin/ProjetsModifier?id={{ projet.id }}">modifier</a></td>
                <td><a href="/Admin/ProjetsDelete?id={{ projet.id }}">supprimer</a></td>    
                <td>{% if projet.icon is not null %}<img src="/images/icon/{{ projet.icon }}" alt="image de l'icon" style="width: 50px; height: 50px;">{% endif %}</td> 
                </tr> 
            {% endfor %} 
                 
         </tbody>
      </table>
      <a href="Admin/ProjetsModifier?id=0">ajouter un nouveau projet</a>

      {{ SESSION['message']|default("") }}

      <a href="/">retour accueil</a>
      <a href="/Admin/users">retour admin</a>

   </body>
</html>